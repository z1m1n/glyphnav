{
  "name": "@glyphnav-demo/sveltekit",
  "version": "0.0.0",
  "private": true,
  "description": "SvelteKit demo for glyphnav, part of the combined demo deploy.",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo"
  },
  "dependencies": {
    "@glyphnav-demo/shared": "workspace:*",
    "glyphnav": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "//typescript": "svelte-check 4.7.7 uses native TypeScript 7 via --tsgo and @typescript/native; TypeScript 6 remains installed for SvelteKit and the checker JavaScript Compiler API."
}
