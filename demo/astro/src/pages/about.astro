---
import DemoLayout from '../layouts/DemoLayout.astro';
---

<DemoLayout>
  <div class="view">
    <article>
      <header class="lead">
        <h2>About</h2>
        Astro loads each destination as HTML and swaps it into the current document.
        Glyphnav uses the same router, preserving its lifecycle events and browser history.
      </header>
      <p id="results">Queries and hashes animate as part of the destination URL, including deployment prefixes.</p>
    </article>
  </div>
</DemoLayout>
