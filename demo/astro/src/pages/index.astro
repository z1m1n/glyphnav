---
import DemoLayout from '../layouts/DemoLayout.astro';
---

<DemoLayout>
  <div class="view">
    <article>
      <header class="lead">
        <h2>Home</h2>
        Astro edition — filesystem routing with <code>ClientRouter</code>.{' '}
        <code>attachGlyphnav(navigate)</code> animates every eligible internal link,
        then awaits Astro's navigation. The shared controls stay in place across document swaps.
      </header>
    </article>
  </div>
</DemoLayout>
