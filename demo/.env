# Dev-server / proxy ports for the demos — the single source of truth.
#
# Each framework's own dev server AND the picker proxy that forwards to it read
# these (via demo/ports.ts), so changing a value here moves both together and
# they can never drift apart. Defaults match the README.
GLYPHNAV_PORT_VITE=5173
GLYPHNAV_PORT_NEXT=5174
GLYPHNAV_PORT_NUXT=5176
GLYPHNAV_PORT_SVELTEKIT=5177
