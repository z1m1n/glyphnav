{
  // Vite transpiles these files (no ngtsc): legacy decorators must be enabled
  // for Angular's @Component/@Directive, and class fields must use the
  // assignment semantics Angular expects.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [],
    // Resolve `glyphnav/*` to the live src (matching demo/vite.config.ts) so the
    // editor and typecheck see real types, not the published dist build.
    "paths": {
      "glyphnav": ["../../src/index.ts"],
      "glyphnav/core": ["../../src/core/index.ts"],
      "glyphnav/angular-router": ["../../src/angular-router/index.ts"]
    }
  },
  "include": ["*.ts", "../highlight.ts", "../shared/content.ts", "../vite-env.d.ts"]
}
