{
  // Vite transpiles these files (no ngtsc): legacy decorators must be enabled
  // for Angular's @Component/@Directive, and class fields must use the
  // assignment semantics Angular expects.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": []
  },
  "include": ["*.ts"]
}
