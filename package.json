{
  "name": "glyphnav",
  "version": "2.4.0",
  "description": "Animate navigation: random glyphs resolve into the destination URL right in the address bar. Framework-agnostic core with Vue Router, React Router, Solid Router, TanStack Router (React & Solid), Angular Router, Preact (preact-iso), Next.js, Nuxt and SvelteKit adapters.",
  "keywords": [
    "address-bar",
    "angular-router",
    "animation",
    "decode",
    "glitch",
    "history",
    "navigation",
    "next",
    "nextjs",
    "nuxt",
    "preact",
    "preact-iso",
    "react-router",
    "router",
    "scramble",
    "solid-js",
    "solid-router",
    "spa",
    "svelte",
    "sveltekit",
    "tanstack-router",
    "text-effect",
    "url",
    "vue-router"
  ],
  "homepage": "https://z1m1n.github.io/glyphnav/",
  "license": "MIT",
  "author": "Konstantins Zimins, konstant1n@z1m.in",
  "repository": {
    "type": "git",
    "url": "https://github.com/z1m1n/glyphnav.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./vue-router": {
      "types": "./dist/vue-router/index.d.ts",
      "import": "./dist/vue-router/index.js",
      "require": "./dist/vue-router/index.cjs"
    },
    "./react-router": {
      "types": "./dist/react-router/index.d.ts",
      "import": "./dist/react-router/index.js",
      "require": "./dist/react-router/index.cjs"
    },
    "./solid-router": {
      "types": "./dist/solid-router/index.d.ts",
      "import": "./dist/solid-router/index.js",
      "require": "./dist/solid-router/index.cjs"
    },
    "./tanstack-router/react": {
      "types": "./dist/tanstack-router/react/index.d.ts",
      "import": "./dist/tanstack-router/react/index.js",
      "require": "./dist/tanstack-router/react/index.cjs"
    },
    "./tanstack-router/solid": {
      "types": "./dist/tanstack-router/solid/index.d.ts",
      "import": "./dist/tanstack-router/solid/index.js",
      "require": "./dist/tanstack-router/solid/index.cjs"
    },
    "./angular-router": {
      "types": "./dist/angular-router/index.d.ts",
      "import": "./dist/angular-router/index.js",
      "require": "./dist/angular-router/index.cjs"
    },
    "./preact-iso": {
      "types": "./dist/preact-iso/index.d.ts",
      "import": "./dist/preact-iso/index.js",
      "require": "./dist/preact-iso/index.cjs"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js",
      "require": "./dist/next/index.cjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt/index.d.ts",
      "import": "./dist/nuxt/index.js",
      "require": "./dist/nuxt/index.cjs"
    },
    "./sveltekit": {
      "types": "./dist/sveltekit/index.d.ts",
      "import": "./dist/sveltekit/index.js",
      "require": "./dist/sveltekit/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test-solid.json && tsc --noEmit -p tsconfig.test-preact.json && pnpm run typecheck:demo",
    "typecheck:demo": "tsc --noEmit -p demo/tsconfig.json && tsc --noEmit -p demo/solid-router/tsconfig.json && tsc --noEmit -p demo/tanstack-router/solid/tsconfig.json && tsc --noEmit -p demo/angular-router/tsconfig.json && tsc --noEmit -p demo/preact-iso/tsconfig.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "demo": "run-p demo:vite demo:next demo:nuxt demo:sveltekit",
    "demo:vite": "vite --config demo/vite.config.ts",
    "demo:next": "pnpm --filter @glyphnav-demo/next dev",
    "demo:nuxt": "pnpm --filter @glyphnav-demo/nuxt dev",
    "demo:sveltekit": "pnpm --filter @glyphnav-demo/sveltekit dev",
    "demo:build": "run-s build demo:build:vite demo:build:next demo:build:nuxt demo:build:sveltekit",
    "demo:build:vite": "vite build --config demo/vite.config.ts",
    "demo:build:next": "pnpm --filter @glyphnav-demo/next build && cp -rT demo/next/out demo/dist/next",
    "demo:build:nuxt": "pnpm --filter @glyphnav-demo/nuxt generate && cp -rT demo/nuxt/.output/public demo/dist/nuxt",
    "demo:build:sveltekit": "pnpm --filter @glyphnav-demo/sveltekit build && cp -rT demo/sveltekit/build demo/dist/sveltekit",
    "demo:preview": "vite preview --config demo/vite.config.ts",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@angular/common": "22.0.4",
    "@angular/compiler": "22.0.4",
    "@angular/core": "22.0.4",
    "@angular/platform-browser": "22.0.4",
    "@angular/router": "22.0.4",
    "@microsoft/api-extractor": "7.58.9",
    "@solidjs/router": "0.16.1",
    "@tanstack/react-router": "1.170.16",
    "@tanstack/solid-router": "1.170.16",
    "@testing-library/dom": "10.4.1",
    "@testing-library/preact": "3.2.4",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitejs/plugin-vue": "6.0.7",
    "@vitest/coverage-v8": "4.1.9",
    "jsdom": "29.1.1",
    "marked": "18.0.5",
    "next": "16.2.9",
    "npm-run-all2": "9.0.2",
    "oxfmt": "0.56.0",
    "oxlint": "1.71.0",
    "preact": "10.29.3",
    "preact-iso": "2.12.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.0.1",
    "rxjs": "7.8.2",
    "solid-js": "1.9.13",
    "typescript": "6.0.3",
    "vite": "8.1.0",
    "vite-plugin-dts": "5.0.3",
    "vite-plugin-solid": "2.11.12",
    "vitest": "4.1.9",
    "vue": "3.5.39",
    "vue-router": "5.1.0"
  },
  "peerDependencies": {
    "@angular/core": ">=16",
    "@angular/router": ">=16",
    "@solidjs/router": ">=0.14",
    "@sveltejs/kit": ">=2",
    "@tanstack/react-router": ">=1",
    "@tanstack/solid-router": ">=1",
    "next": ">=14",
    "nuxt": ">=3",
    "preact": ">=10",
    "preact-iso": ">=2",
    "react": ">=18",
    "react-dom": ">=18",
    "react-router": ">=6",
    "solid-js": ">=1.9",
    "svelte": ">=4",
    "vue": ">=3",
    "vue-router": ">=4"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "@angular/router": {
      "optional": true
    },
    "@solidjs/router": {
      "optional": true
    },
    "@sveltejs/kit": {
      "optional": true
    },
    "@tanstack/react-router": {
      "optional": true
    },
    "@tanstack/solid-router": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "nuxt": {
      "optional": true
    },
    "preact": {
      "optional": true
    },
    "preact-iso": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-router": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@11.9.0"
}
