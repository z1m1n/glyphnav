{
  "name": "glyphnav",
  "version": "0.1.3",
  "description": "Animate navigation: random glyphs resolve into the destination URL right in the address bar. Framework-agnostic core with Vue Router, React Router, TanStack Router (React & Solid) and Angular Router adapters.",
  "keywords": [
    "address-bar",
    "angular-router",
    "animation",
    "decode",
    "glitch",
    "history",
    "navigation",
    "react-router",
    "router",
    "scramble",
    "solid-js",
    "solid-router",
    "spa",
    "tanstack-router",
    "text-effect",
    "url",
    "vue-router"
  ],
  "homepage": "https://github.com/z1m1n/glyphnav#readme",
  "license": "MIT",
  "author": "Konstantins Zimins, konstant1n@z1m.in",
  "repository": {
    "type": "git",
    "url": "https://github.com/z1m1n/glyphnav.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./vue-router": {
      "types": "./dist/vue-router.d.ts",
      "import": "./dist/vue-router.js",
      "require": "./dist/vue-router.cjs"
    },
    "./react-router": {
      "types": "./dist/react-router.d.ts",
      "import": "./dist/react-router.js",
      "require": "./dist/react-router.cjs"
    },
    "./tanstack-react-router": {
      "types": "./dist/tanstack-react-router.d.ts",
      "import": "./dist/tanstack-react-router.js",
      "require": "./dist/tanstack-react-router.cjs"
    },
    "./tanstack-solid-router": {
      "types": "./dist/tanstack-solid-router.d.ts",
      "import": "./dist/tanstack-solid-router.js",
      "require": "./dist/tanstack-solid-router.cjs"
    },
    "./angular-router": {
      "types": "./dist/angular-router.d.ts",
      "import": "./dist/angular-router.js",
      "require": "./dist/angular-router.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test-solid.json && pnpm run typecheck:demo",
    "typecheck:demo": "tsc --noEmit -p demo/tsconfig.json && tsc --noEmit -p demo/tanstack-solid-router/tsconfig.json && tsc --noEmit -p demo/angular-router/tsconfig.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "demo:preview": "vite preview --config demo/vite.config.ts",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@angular/common": "22.0.0",
    "@angular/compiler": "22.0.0",
    "@angular/core": "22.0.0",
    "@angular/platform-browser": "22.0.0",
    "@angular/router": "22.0.0",
    "@microsoft/api-extractor": "^7.58.8",
    "@tanstack/react-router": "1.170.15",
    "@tanstack/solid-router": "1.170.15",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.9.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-vue": "6.0.7",
    "@vitest/coverage-v8": "4.1.8",
    "jsdom": "29.1.1",
    "oxfmt": "0.54.0",
    "oxlint": "1.69.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.17.0",
    "rxjs": "7.8.2",
    "solid-js": "1.9.13",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vite-plugin-dts": "5.0.2",
    "vite-plugin-solid": "2.11.12",
    "vitest": "4.1.8",
    "vue": "3.5.35",
    "vue-router": "5.1.0"
  },
  "peerDependencies": {
    "@angular/core": ">=16",
    "@angular/router": ">=16",
    "@tanstack/react-router": ">=1",
    "@tanstack/solid-router": ">=1",
    "react": ">=18",
    "react-dom": ">=18",
    "react-router-dom": ">=6",
    "solid-js": ">=1.9",
    "vue": ">=3",
    "vue-router": ">=4"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "@angular/router": {
      "optional": true
    },
    "@tanstack/react-router": {
      "optional": true
    },
    "@tanstack/solid-router": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@11.5.2"
}
